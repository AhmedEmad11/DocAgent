{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Authentication": {
    "External": {
      "AllowedReturnUrls": []
    }
  },
  "Email": {
    "FromAddress": "noreply@docagent.local",
    "FromName": "DocAgent",
    "Smtp": {
      "UseStartTls": false
    }
  },
  "Embeddings": {
    "ModelPath": "models/multilingual-e5-small",
    "MaxSequenceLength": 512,
    "BatchSize": 16
  },
  "Chunking": {
    "TargetTokens": 400,
    "MaxTokens": 480,
    "OverlapTokens": 60
  },
  "Documents": {
    "Limits": {
      "Demo": {
        "MaxDocuments": 3,
        "MaxFileBytes": 5242880
      },
      "Byok": {
        "MaxDocuments": 100,
        "MaxFileBytes": 26214400
      }
    },
    "Ingestion": {
      "ParseTimeoutSeconds": 60,
      "MaxAttempts": 3,
      "PollIntervalSeconds": 2,
      "MaxDocxUncompressedBytes": 52428800,
      "MaxDocxEntries": 2000,
      "MaxPdfPages": 2000,
      "MinCharsPerPdfPage": 20,
      "WorkerEnabled": true
    }
  }
}
