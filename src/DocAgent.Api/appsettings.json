{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Extensions.AI": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Authentication": {
    "External": {
      "AllowedReturnUrls": []
    }
  },
  "Email": {
    "FromAddress": "noreply@docagent.local",
    "FromName": "DocAgent",
    "Smtp": {
      "UseStartTls": false
    }
  },
  "Embeddings": {
    "ModelPath": "models/multilingual-e5-small",
    "MaxSequenceLength": 512,
    "BatchSize": 16
  },
  "Chunking": {
    "TargetTokens": 400,
    "MaxTokens": 480,
    "OverlapTokens": 60
  },
  "Documents": {
    "Limits": {
      "Demo": {
        "MaxDocuments": 3,
        "MaxFileBytes": 5242880
      },
      "Byok": {
        "MaxDocuments": 100,
        "MaxFileBytes": 26214400
      }
    },
    "Ingestion": {
      "ParseTimeoutSeconds": 60,
      "MaxAttempts": 3,
      "PollIntervalSeconds": 2,
      "MaxDocxUncompressedBytes": 52428800,
      "MaxDocxEntries": 2000,
      "MaxPdfPages": 2000,
      "MinCharsPerPdfPage": 20,
      "WorkerEnabled": true
    }
  },
  "Llm": {
    "Provider": "Ollama",
    "Ollama": {
      "Endpoint": "http://localhost:11434",
      "Model": "gemma4:12b",
      "Think": false,
      "NumCtx": 8192
    }
  },
  "Retrieval": {
    "TopK": 8,
    "MinScore": 0.8,
    "MaxContextTokens": 3000,
    "Hybrid": true
  },
  "Qa": {
    "Mode": "Agent",
    "TimeoutSeconds": 120
  },
  "Agent": {
    "Limits": {
      "Development": { "MaxToolCalls": 10, "TimeoutSeconds": 120 },
      "Demo": { "MaxToolCalls": 4, "TimeoutSeconds": 60 },
      "Byok": { "MaxToolCalls": 10, "TimeoutSeconds": 120 }
    },
    "SearchTopK": 5,
    "MaxOutputTokens": 1024,
    "ContextBudgetTokens": 3600,
    "MapBudgetTokens": 2800
  }
}
