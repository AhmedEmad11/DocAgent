{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Extensions.AI": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "",
  "HttpsRedirection": {
    "Enabled": false
  },
  "ForwardedHeaders": {
    "Enabled": true,
    "ForwardLimit": 1
  },
  "Llm": {
    "NoKeyRoute": "Demo"
  },
  "Email": {
    "Smtp": {
      "Host": "smtp-relay.brevo.com",
      "Port": 587,
      "UseStartTls": true
    }
  },
  "DataProtection": {
    "Store": "Database"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Embeddings": {
    "BatchSize": 4,
    "UseCpuMemoryArena": false,
    "UseMemoryPattern": false,
    "TrimNativeHeap": true,
    "LowMemoryLoad": true
  }
}
