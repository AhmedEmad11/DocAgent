# Copy to .env.local (git-ignored). Placeholders only; never commit real values (UI-SEC-9).
# No secret may use the NEXT_PUBLIC_ prefix: those values are shipped to the browser.

# Base URL of the DocAgent API (server only). Local AppHost/dotnet run, or the SnapDeploy URL in production.
DOCAGENT_API_URL=https://localhost:7090

# 32+ random bytes for session cookie encryption (server only), e.g. `openssl rand -base64 32`.
SESSION_SECRET=replace-with-32-or-more-random-characters
# Optional previous secret while rotating (sessions sealed with it stay valid until the next refresh).
# SESSION_SECRET_PREVIOUS=

# Public origin of the UI (not a secret). Open the site on exactly this origin: the Origin check (UI-SEC-3) rejects others,
# so `localhost:3000` and `127.0.0.1:3000` are different. The API must list `<this>/api/auth/external/callback` in
# Authentication:External:AllowedReturnUrls (appsettings.Development.json has the localhost one).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret that authenticates the forwarded client IP to the API (Bff:SharedSecret, D41; at least 16 characters).
# Optional locally: when the API has no Bff:SharedSecret it ignores the forwarded IP.
BFF_SHARED_SECRET=replace-with-the-same-value-as-Bff:SharedSecret
