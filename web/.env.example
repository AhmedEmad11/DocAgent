# Copy to .env.local (git-ignored). Placeholders only; never commit real values (UI-SEC-9).
# No secret may use the NEXT_PUBLIC_ prefix: those values are shipped to the browser.

# Base URL of the DocAgent API (server only). Local AppHost/dotnet run, or the SnapDeploy URL in production.
DOCAGENT_API_URL=https://localhost:7090

# 32+ random bytes for session cookie encryption (server only), e.g. `openssl rand -base64 32`. Used from 9.1.
SESSION_SECRET=replace-with-32-or-more-random-characters
# Optional previous secret while rotating. Used from 9.1.
# SESSION_SECRET_PREVIOUS=

# Public origin of the UI (not a secret).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret that authenticates the forwarded client IP to the API (Bff:SharedSecret, D41). Used from 9.1.
BFF_SHARED_SECRET=replace-with-the-same-value-as-Bff:SharedSecret
