<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>DocAgent.EvalTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Test plumbing shared with the integration tests (same namespaces, so the files work unchanged). -->
  <ItemGroup>
    <Compile Include="..\Shared\ModelLocator.cs" Link="Shared\ModelLocator.cs" />
    <Compile Include="..\DocAgent.IntegrationTests\DocAgentApiFactory.cs" Link="Shared\DocAgentApiFactory.cs" />
    <Compile Include="..\DocAgent.IntegrationTests\AuthTestHelpers.cs" Link="Shared\AuthTestHelpers.cs" />
    <Compile Include="..\DocAgent.IntegrationTests\CapturingEmailSender.cs" Link="Shared\CapturingEmailSender.cs" />
    <Compile Include="..\DocAgent.IntegrationTests\DocumentTestHelpers.cs" Link="Shared\DocumentTestHelpers.cs" />
    <Compile Include="..\DocAgent.IntegrationTests\PostgresFixture.cs" Link="Shared\PostgresFixture.cs" />
    <Compile Include="..\DocAgent.IntegrationTests\TestDatabase.cs" Link="Shared\TestDatabase.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Corpus\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="eval-set.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DocAgent.Api\DocAgent.Api.csproj" />
  </ItemGroup>

</Project>
